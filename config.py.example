# Trading limits (in INR, since Dhan trades on Indian exchanges)
MIN_SELLING_AMOUNT_USD = 1.0                   # Minimum sell amount in INR (False - disable setting)
MAX_SELLING_AMOUNT_USD = 10.0                  # Maximum sell amount in INR (False - disable setting)
MIN_BUYING_AMOUNT_USD = 1.0                    # Minimum buy amount in INR (False - disable setting)
MAX_BUYING_AMOUNT_USD = 10.0                   # Maximum buy amount in INR (False - disable setting)
PORTFOLIO_LIMIT = 10                           # Number of stocks to hold in the portfolio
WATCHLIST_OVERVIEW_LIMIT = 5                   # Max stocks to analyze from watchlist per run

# OpenAI config params
OPENAI_MODEL_NAME = "gpt-4o-mini"              # OpenAI model name