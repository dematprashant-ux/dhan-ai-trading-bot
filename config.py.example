# Dhan API Credentials
DHAN_CLIENT_ID = ""                            # Dhan Client ID (from https://www.dhan.co)
DHAN_ACCESS_TOKEN = ""                         # Dhan Access Token (generate via OAuth or PIN+TOTP)

# OpenAI Credentials
OPENAI_API_KEY = "..."                         # OpenAI API key

# Basic config parameters
MODE = "demo"                                  # Trading mode (demo, auto, manual)
LOG_LEVEL = "INFO"                             # Log level (DEBUG, INFO, WARNING, ERROR)
RUN_INTERVAL_SECONDS = 600                     # Trading interval in seconds (if the market is open)

# Dhan exchange and product settings
DHAN_EXCHANGE_SEGMENT = "NSE_EQ"               # Exchange segment (NSE_EQ, BSE_EQ, NSE_FNO, etc.)
DHAN_PRODUCT_TYPE = "CNC"                      # Product type (CNC = Delivery, INTRADAY = Intraday)

# Dhan trading config parameters
TRADE_EXCEPTIONS = []                          # List of stocks to exclude from trading (e.g. ["RELIANCE", "TCS", "INFY"])
WATCHLIST_SYMBOLS = []                         # List of stock symbols to watch (e.g. ["RELIANCE", "TCS", "INFY", "HDFCBANK"])

# Security ID Map: Maps stock ticker symbols to Dhan's numeric security IDs
# You can find security IDs from Dhan's scrip master CSV:
#   https://images.dhan.co/api-data/api-scrip-master.csv
# Or use the Dhan API: https://api.dhan.co/v2/
SECURITY_ID_MAP = {
