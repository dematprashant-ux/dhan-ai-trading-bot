# Dhan API Credentials
DHAN_CLIENT_ID = ""  # Dhan Client ID (from https://www.dhan.co)
DHAN_ACCESS_TOKEN = ""  # Dhan Access Token (generate via OAuth or PIN+TOTP)

# AI Model Configurations
OPENAI_API_KEY = ""  # OpenAI API key (optional)
OMNIROUTE_API_KEY = ""  # Omniroute API key (optional)
OMNIROUTE_MODEL = ""  # Omniroute model name (optional)

# Basic Config Parameters
MODE = "demo"                                  # Trading mode (demo, auto, manual)
LOG_LEVEL = "INFO"                             # Log level (DEBUG, INFO, WARNING, ERROR)
RUN_INTERVAL_SECONDS = 600                     # Trading interval in seconds (market open)

# Dhan Exchange Settings
DHAN_EXCHANGE_SEGMENT = "NSE_FNO"              # Exchange segment (NSE_FNO for options)
DHAN_PRODUCT_TYPE = "INTRADAY"                 # Product type (INTRADAY for options)

# Account Configuration
ACCOUNT_BALANCE = 1000000.0                    # Trading capital in INR
RISK_PER_TRADE = 0.02                          # Risk percentage per trade

# Risk Management
MAX_DAILY_LOSS = 5000.0                        # Maximum daily loss in INR
LOT_SIZE = 15                                  # Bank Nifty lot size
MAX_POSITION_SIZE = 3                          # Max lots per symbol
TRADE_EXCEPTIONS = ["INFY", "TCS"]             # Symbols to exclude

# Trading Symbols
WATCHLIST_SYMBOLS = ["BANKNIFTY"]              # Symbols to monitor

# Security ID Map (Bank Nifty Futures)
SECURITY_ID_MAP = {
    "BANKNIFTY": "26009"                       # Bank Nifty futures security ID
}

# Position Sizing
MIN_SELLING_AMOUNT_USD = False                 # Disable amount limits
MAX_SELLING_AMOUNT_USD = False
MIN_BUYING_AMOUNT_USD = False
MAX_BUYING_AMOUNT_USD = False
PORTFOLIO_LIMIT = 1                            # Max concurrent positions
WATCHLIST_OVERVIEW_LIMIT = 1                   # Symbols analyzed per run